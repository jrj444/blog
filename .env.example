# ── Database（Supabase Postgres，经 Drizzle 直连）─────────────
# 直连 5432：仅用于 Drizzle 迁移（drizzle-kit generate/migrate）
DATABASE_URL=
# 连接池 6543：运行时（Server Component / Server Action / Route Handler）
DATABASE_URL_POOLER=

# ── Auth（Auth.js / NextAuth · GitHub OAuth）─────────────────
# GitHub OAuth App 的 Client ID / Secret
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 会话签名密钥。本地生成：npx auth secret 或 openssl rand -base64 32
AUTH_SECRET=
# 站点正式地址（生产必填，如 https://yourdomain.com，无结尾斜杠）
SITE_URL=
# Auth.js 回调地址（生产填正式域名；本地可留 localhost:3000）
AUTH_URL=http://localhost:3000

# ── Admin ────────────────────────────────────────────────────
# 唯一允许登录后台的 GitHub 邮箱（逗号分隔）。通常只填你一个。
ADMIN_EMAILS=
# ── 代理（可选）────────────────────────────────────────────
# 若你的网络无法直连 GitHub（如境内），请给服务端配置代理，否则
# GitHub OAuth 回调用 code 换 token 会超时/被重置。
# 端口以你本地 Clash / 代理软件为准（Clash 默认 7890）。
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897

# ── 对象存储（Cloudflare R2，封面图）─────────────────────────
# 端点 https://<account-id>.r2.cloudflarestorage.com 里的那段子域
R2_ACCOUNT_ID=
# R2 → Manage API Tokens 生成（权限 Object Read & Write，限定到桶）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 桶绑定的自定义域名（公开读取走它，带 Cloudflare 边缘缓存）
R2_PUBLIC_BASE_URL=https://cdn.jiangruijian.com
